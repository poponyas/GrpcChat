PROJECT_ROOT=.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=chat
POSTGRES_PASSWORD=local-chat-password
POSTGRES_DB=grpcchat
POSTGRES_TIMEOUT=5s
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
TIME_ZONE=Europe/Moscow
LOGGER_LEVEL=info
LOGGER_FOLDER=logs
# Remote hosting requires TLS:
# GRPC_HOST=0.0.0.0
# GRPC_TLS_CERT=/absolute/path/server.crt
# GRPC_TLS_KEY=/absolute/path/server.key
